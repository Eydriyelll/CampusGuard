{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ (console)",
            "type": "shell",
            "command": "./build_native.sh"
        },
        {
            "label": "Configure window app",
            "type": "shell",
            "command": "cmake -S . -B build-gui -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "Build window app",
            "type": "shell",
            "command": "cmake --build build-gui --target campusguard_gui",
            "dependsOn": "Configure window app",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build WebAssembly (browser/phone)",
            "type": "shell",
            "command": "./build_wasm.sh"
        },
        {
            "label": "Serve in browser",
            "type": "shell",
            "command": "python3 -m http.server 8080 --directory web"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}